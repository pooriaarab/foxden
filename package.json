{
  "name": "foxden-sandbox",
  "version": "0.1.4",
  "description": "Browser Python sandbox with Pyodide, isolated workers, local file stores, snapshots, and timeout recovery.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxden.git"
  },
  "homepage": "https://github.com/pooriaarab/foxden#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-den.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "node scripts/lint-ext.mjs",
    "check:amo": "node scripts/amo-listing.mjs check",
    "e2e": "pnpm build && pnpm build:ext && node e2e/run.mjs",
    "e2e:web": "pnpm build && pnpm build:ext && node e2e/web.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "create-foxkit": "^0.1.0",
    "esbuild": "^0.28.2",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "pyodide": "314.0.7"
  },
  "keywords": [
    "python",
    "pyodide",
    "sandbox",
    "browser",
    "webassembly",
    "firefox",
    "webextension",
    "typescript",
    "indexeddb",
    "code-interpreter",
    "local-files",
    "snapshots"
  ]
}
